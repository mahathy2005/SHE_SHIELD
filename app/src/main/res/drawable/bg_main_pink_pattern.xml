<?xml version="1.0" encoding="utf-8"?>

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- MAIN LIGHT PINK BACKGROUND -->

    <item>
        <shape android:shape="rectangle">

            <solid android:color="#FFF8FA" />

        </shape>
    </item>


    <!-- TOP SOFT PINK GLOW -->

    <item
        android:left="-80dp"
        android:top="70dp">

        <shape android:shape="oval">

            <size
                android:width="260dp"
                android:height="260dp" />

            <solid android:color="#18F7A8BE" />

        </shape>

    </item>


    <!-- RIGHT SIDE LARGE SOFT CIRCLE -->

    <item
        android:left="250dp"
        android:top="230dp">

        <shape android:shape="oval">

            <size
                android:width="220dp"
                android:height="220dp" />

            <solid android:color="#14F48FB1" />

        </shape>

    </item>


    <!-- MIDDLE SOFT CIRCLE -->

    <item
        android:left="-70dp"
        android:top="520dp">

        <shape android:shape="oval">

            <size
                android:width="190dp"
                android:height="190dp" />

            <solid android:color="#12F8BBD0" />

        </shape>

    </item>


    <!-- BOTTOM RIGHT GLOW -->

    <item
        android:left="230dp"
        android:top="850dp">

        <shape android:shape="oval">

            <size
                android:width="260dp"
                android:height="260dp" />

            <solid android:color="#16E1BEE7" />

        </shape>

    </item>


    <!-- BOTTOM LEFT SOFT SHADOW -->

    <item
        android:left="-100dp"
        android:top="1150dp">

        <shape android:shape="oval">

            <size
                android:width="250dp"
                android:height="250dp" />

            <solid android:color="#12FCE4EC" />

        </shape>

    </item>

</layer-list>