<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA">

    <!-- ===================================================== -->
    <!-- TOP LIGHT BACKGROUND -->
    <!-- ===================================================== -->

    <View
        android:id="@+id/topBackground"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:background="#F1F3FF" />


    <!-- ===================================================== -->
    <!-- CALL HEADER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="55dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCallType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INCOMING CALL"
            android:textColor="#000000"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Amma"
            android:textColor="#000000"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Mobile +91 98765 43210"
            android:textColor="#000000"
            android:textSize="14sp" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- PROFILE CIRCLE -->
    <!-- ===================================================== -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cardProfile"
        android:layout_width="126dp"
        android:layout_height="126dp"
        android:layout_below="@id/headerContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="34dp"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="63dp"
        app:cardElevation="8dp">

        <ImageView
            android:id="@+id/imgCallerProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="31dp"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="#000000" />

    </androidx.cardview.widget.CardView>


    <!-- ===================================================== -->
    <!-- INCOMING CALL SWIPE -->
    <!-- ===================================================== -->

    <RelativeLayout
        android:id="@+id/containerSwipeTrack"
        android:layout_width="match_parent"
        android:layout_height="74dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="55dp"
        android:background="@drawable/bg_swipe_track">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="24dp"
            android:text="Decline"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="24dp"
            android:text="Answer"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardSwipeKnob"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:layout_centerInParent="true"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="31dp"
            app:cardElevation="8dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp"
                android:src="@android:drawable/ic_menu_call"
                app:tint="#000000" />

        </androidx.cardview.widget.CardView>

    </RelativeLayout>


    <!-- ===================================================== -->
    <!-- PLACEHOLDER -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/incomingActions"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:orientation="vertical"
        android:visibility="gone" />


    <!-- ===================================================== -->
    <!-- IN CALL CONTROLS -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/inCallControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="25dp"
        android:orientation="vertical"
        android:visibility="gone">


        <!-- ROW 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">


            <!-- MUTE -->

            <LinearLayout
                android:id="@+id/btnMute"
                android:layout_width="110dp"
                android:layout_height="90dp"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="15dp"
                        android:src="@android:drawable/ic_lock_silent_mode"
                        app:tint="#000000" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvMute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Mute"
                    android:textColor="#000000"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- KEYPAD -->

            <LinearLayout
                android:id="@+id/btnKeypad"
                android:layout_width="110dp"
                android:layout_height="90dp"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="15dp"
                        android:src="@android:drawable/ic_dialog_dialer"
                        app:tint="#000000" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Keypad"
                    android:textColor="#000000"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- SPEAKER -->

            <LinearLayout
                android:id="@+id/btnSpeaker"
                android:layout_width="110dp"
                android:layout_height="90dp"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="15dp"
                        android:src="@android:drawable/ic_lock_silent_mode_off"
                        app:tint="#000000" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvSpeaker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Speaker"
                    android:textColor="#000000"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- ROW 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">


            <!-- ADD CALL -->

            <LinearLayout
                android:id="@+id/btnAddCall"
                android:layout_width="110dp"
                android:layout_height="90dp"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="15dp"
                        android:src="@android:drawable/ic_menu_add"
                        app:tint="#000000" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Add call"
                    android:textColor="#000000"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- HOLD -->

            <LinearLayout
                android:id="@+id/btnHold"
                android:layout_width="110dp"
                android:layout_height="90dp"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:padding="15dp"
                        android:src="@android:drawable/ic_media_pause"
                        app:tint="#000000" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/tvHold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Hold"
                    android:textColor="#000000"
                    android:textSize="13sp" />

            </LinearLayout>


            <!-- MORE -->

            <LinearLayout
                android:id="@+id/btnMore"
                android:layout_width="110dp"
                android:layout_height="90dp"
                android:gravity="center"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="15dp"
                        android:src="@android:drawable/ic_menu_more"
                        app:tint="#000000" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="More"
                    android:textColor="#000000"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- END CALL -->

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabEndCall"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:layout_marginTop="18dp"
            android:contentDescription="End Call"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:backgroundTint="#E53935"
            app:elevation="8dp"
            app:tint="#FFFFFF" />

    </LinearLayout>


    <!-- ===================================================== -->
    <!-- KEYPAD -->
    <!-- ===================================================== -->

    <LinearLayout
        android:id="@+id/keypadContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingTop="18dp"
        android:paddingBottom="25dp"
        android:visibility="gone">


        <TextView
            android:id="@+id/tvDialNumber"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:gravity="center"
            android:text=""
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />


        <!-- ROW 1 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:gravity="center">

            <TextView
                android:id="@+id/key1"
                android:layout_width="82dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="1"
                android:textColor="#000000"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/key2"
                android:layout_width="82dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="2"
                android:textColor="#000000"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/key3"
                android:layout_width="82dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="3"
                android:textColor="#000000"
                android:textSize="24sp" />

        </LinearLayout>


        <!-- ROW 2 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:gravity="center">

            <TextView
                android:id="@+id/key4"
                android:layout_width="82dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="4"
                android:textColor="#000000"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/key5"
                android:layout_width="82dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="5"
                android:textColor="#000000"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/key6"
                android:layout_width="82dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="6"
                android:textColor="#000000"
                android:textSize="24sp" />

        </LinearLayout>


        <!-- ROW 3 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:gravity="center">

            <TextView
                android:id="@+id/key7"
                android:layout_width="82dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="7"
                android:textColor="#000000"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/key8"
                android:layout_width="82dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="8"
                android:textColor="#000000"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/key9"
                android:layout_width="82dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="9"
                android:textColor="#000000"
                android:textSize="24sp" />

        </LinearLayout>


        <!-- ROW 4 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:gravity="center">

            <TextView
                android:id="@+id/keyStar"
                android:layout_width="82dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="*"
                android:textColor="#000000"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/key0"
                android:layout_width="82dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="0"
                android:textColor="#000000"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/keyHash"
                android:layout_width="82dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:text="#"
                android:textColor="#000000"
                android:textSize="24sp" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>