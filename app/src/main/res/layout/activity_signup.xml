<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCE4EC"
    android:fillViewport="true"
    tools:context=".SignUpActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TITLE -->
        <TextView
            android:id="@+id/tvSignUpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Create Account"
            android:textColor="#E91E63"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tvSignUpSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Step 1: Personal &amp; Guardian Details"
            android:textColor="#555555"
            android:textSize="13sp" />


        <!-- PERSONAL DETAILS SECTION -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="PERSONAL DETAILS"
            android:textColor="#1A1A2E"
            android:textSize="12sp"
            android:textStyle="bold" />


        <!-- FULL NAME -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Full Name *"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63"
            app:startIconDrawable="@android:drawable/ic_menu_myplaces"
            app:startIconTint="#8E24AA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- DATE OF BIRTH -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Date of Birth (Select Date) *"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63"
            app:startIconDrawable="@android:drawable/ic_menu_today"
            app:startIconTint="#8E24AA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:importantForAutofill="no"
                android:inputType="none"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- AGE -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Age (Auto Calculated)"
            app:boxBackgroundColor="#F5F5F5"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:focusable="false"
                android:importantForAutofill="no"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- BLOOD GROUP -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Blood Group *"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63">

            <AutoCompleteTextView
                android:id="@+id/etBloodGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="none"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- User Mobile Number -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Mobile Number *"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63"
            app:startIconDrawable="@android:drawable/ic_menu_call"
            app:startIconTint="#8E24AA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUserMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:maxLength="10"
                android:importantForAutofill="no"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- PERSONAL EMAIL -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Email Address *"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="#8E24AA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ADDRESS + GPS -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Address *"
                app:boxBackgroundColor="#FFFFFF"
                app:boxStrokeColor="#E91E63"
                app:hintTextColor="#E91E63"
                app:startIconDrawable="@android:drawable/ic_menu_mapmode"
                app:startIconTint="#8E24AA">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAutofill="no"
                    android:inputType="textPostalAddress"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFetchLocation"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="3dp"
                android:paddingHorizontal="12dp"
                android:text="GPS"
                android:textColor="#E91E63"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_menu_mylocation"
                app:iconTint="#E91E63"
                app:strokeColor="#E91E63" />

        </LinearLayout>


        <!-- ABOUT -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="About Yourself"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAbout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:lines="2"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- GUARDIAN DETAILS -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium"
            android:text="PRIMARY GUARDIAN / PARENT DETAILS (MANDATORY)"
            android:textColor="#E91E63"
            android:textSize="12sp"
            android:textStyle="bold" />


        <!-- GUARDIAN NAME -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Guardian Name *"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63"
            app:startIconDrawable="@android:drawable/ic_menu_myplaces"
            app:startIconTint="#8E24AA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGuardianName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPersonName"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- GUARDIAN RELATION -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Relation *"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63">

            <AutoCompleteTextView
                android:id="@+id/etGuardianRelation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="none"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- GUARDIAN MOBILE -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Guardian Mobile Number *"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63"
            app:startIconDrawable="@android:drawable/ic_menu_call"
            app:startIconTint="#8E24AA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGuardianMobile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="phone"
                android:maxLength="10"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- GUARDIAN BLOOD GROUP -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Guardian Blood Group *"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63">

            <AutoCompleteTextView
                android:id="@+id/etGuardianBloodGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="none"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- GUARDIAN EMAIL -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Guardian Email *"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:startIconTint="#8E24AA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGuardianEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textEmailAddress"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- GUARDIAN ADDRESS -->

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Guardian Address *"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63"
            app:startIconDrawable="@android:drawable/ic_menu_mapmode"
            app:startIconTint="#8E24AA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGuardianAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="textPostalAddress"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- NEXT BUTTON -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNext"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="NEXT"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#E91E63"
            app:cornerRadius="12dp"
            app:elevation="2dp" />

    </LinearLayout>

</ScrollView>