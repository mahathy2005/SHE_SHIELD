<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCE4EC"
    android:fillViewport="true"
    tools:context=".PasswordSetupActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvPasswordTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Set Password"
            android:textColor="#E91E63"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/tvPasswordSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Step 2: Secure your account with a password"
            android:textColor="#555555"
            android:textSize="13sp" />

        <!-- Password -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="Password *"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63"
            app:passwordToggleEnabled="true"
            app:startIconDrawable="@android:drawable/ic_lock_lock"
            app:startIconTint="#8E24AA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm Password -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Confirm Password *"
            app:boxBackgroundColor="#FFFFFF"
            app:boxStrokeColor="#E91E63"
            app:hintTextColor="#E91E63"
            app:passwordToggleEnabled="true"
            app:startIconDrawable="@android:drawable/ic_lock_lock"
            app:startIconTint="#8E24AA">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Final Sign Up Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinalSignUp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:fontFamily="sans-serif-medium"
            android:text="SIGN UP"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#E91E63"
            app:cornerRadius="12dp"
            app:elevation="2dp" />

    </LinearLayout>
</ScrollView>