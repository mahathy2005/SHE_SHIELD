<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF1F7">

    <!-- ========================================================= -->
    <!-- SOFT PINK BACKGROUND -->
    <!-- ========================================================= -->

    <View
        android:id="@+id/bgPinkTop"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:alpha="0.45"
        android:background="@drawable/bg_soft_blob"
        android:translationX="105dp"
        android:translationY="-115dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/bgPinkBottom"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:alpha="0.30"
        android:background="@drawable/bg_soft_blob"
        android:translationX="-115dp"
        android:translationY="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="112dp"
        android:background="#E91E63"
        android:elevation="5dp"
        android:paddingStart="14dp"
        android:paddingEnd="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Decorative pink highlight -->

        <View
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:alpha="0.10"
            android:background="@drawable/bg_soft_blob"
            android:translationX="35dp"
            android:translationY="-45dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- BACK BUTTON -->

        <androidx.cardview.widget.CardView
            android:id="@+id/backButtonContainer"
            android:layout_width="46dp"
            android:layout_height="46dp"
            app:cardBackgroundColor="#35FFFFFF"
            app:cardCornerRadius="23dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="Back"
                android:padding="12dp"
                android:src="@android:drawable/ic_menu_revert"
                android:tint="@android:color/white" />

        </androidx.cardview.widget.CardView>


        <!-- HEADER TEXT -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/backButtonContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/backButtonContainer"
            app:layout_constraintTop_toTopOf="@id/backButtonContainer">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Trusted Contacts"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Your personal safety circle"
                android:textColor="#FFE5EF"
                android:textSize="12sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- ========================================================= -->
    <!-- MAIN SCROLL AREA -->
    <!-- ========================================================= -->

    <ScrollView
        android:id="@+id/contactScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="35dp">


            <!-- ================================================= -->
            <!-- WELCOME / SAFETY CARD -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/infoCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <!-- HEART ICON -->

                    <androidx.cardview.widget.CardView
                        android:id="@+id/infoIconContainer"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        app:cardBackgroundColor="#FCE4EC"
                        app:cardCornerRadius="29dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="♥"
                            android:textColor="#E91E63"
                            android:textSize="27sp"
                            android:textStyle="bold" />

                    </androidx.cardview.widget.CardView>


                    <!-- TEXT -->

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvInfoTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Your safety circle"
                            android:textColor="#2D2B52"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Add people you trust. They can receive emergency alerts and your location when you need help."
                            android:textColor="#777487"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- PRIVACY BADGE -->
            <!-- ================================================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/privacyRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="#FFE4EF"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="7dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="7dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Private &amp; secure"
                        android:textColor="#C2185B"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ================================================= -->
            <!-- ADD CONTACT BUTTON -->
            <!-- ================================================= -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddContact"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:text="+   Add Trusted Contact"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#D81B60"
                app:cornerRadius="18dp"
                app:elevation="4dp" />


            <!-- ================================================= -->
            <!-- SECTION HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="27dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trusted people"
                        android:textColor="#2D2B52"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="People who can be there when you need them"
                        android:textColor="#8A879B"
                        android:textSize="11sp" />

                </LinearLayout>


                <!-- HEART BADGE -->

                <androidx.cardview.widget.CardView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    app:cardBackgroundColor="#FCE4EC"
                    app:cardCornerRadius="21dp"
                    app:cardElevation="0dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="♥"
                        android:textColor="#E91E63"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- CONTACTS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/contactsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">


                <!-- ============================================= -->
                <!-- EMPTY STATE -->
                <!-- ============================================= -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/emptyStateCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingStart="25dp"
                        android:paddingTop="32dp"
                        android:paddingEnd="25dp"
                        android:paddingBottom="32dp">


                        <!-- ICON -->

                        <androidx.cardview.widget.CardView
                            android:layout_width="82dp"
                            android:layout_height="82dp"
                            app:cardBackgroundColor="#FCE4EC"
                            app:cardCornerRadius="41dp"
                            app:cardElevation="0dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="👥"
                                android:textSize="34sp" />

                        </androidx.cardview.widget.CardView>


                        <!-- TITLE -->

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="17dp"
                            android:text="No trusted contacts yet"
                            android:textColor="#2D2B52"
                            android:textSize="18sp"
                            android:textStyle="bold" />


                        <!-- DESCRIPTION -->

                        <TextView
                            android:layout_width="290dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:gravity="center"
                            android:lineSpacingExtra="3dp"
                            android:text="Add family members or friends you trust. They can be contacted quickly during an emergency."
                            android:textColor="#7A7893"
                            android:textSize="12sp" />


                        <!-- DIVIDER -->

                        <View
                            android:layout_width="60dp"
                            android:layout_height="2dp"
                            android:layout_marginTop="18dp"
                            android:background="#F8BBD0" />


                        <!-- FOOTER -->

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:text="You can add as many contacts as you need ♥"
                            android:textColor="#C2185B"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>